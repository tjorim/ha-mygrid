{
  "domain": "mygrid",
  "name": "MyGrid",
  "codeowners": [
    "@tjorim"
  ],
  "config_flow": true,
  "dependencies": [
    "modbus"
  ],
  "dhcp": [
    {
      "registered_devices": true
    }
  ],
  "documentation": "https://github.com/tjorim/ha-mygrid/blob/main/README.md",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/tjorim/ha-mygrid/issues",
  "loggers": [
    "modbus_connection",
    "mygrid_voltbridge",
    "tmodbus"
  ],
  "requirements": [],
  "version": "0.1.0",
  "zeroconf": [
    {
      "type": "_mygrid._tcp.local.",
      "properties": {
        "model": "voltbridge*"
      }
    }
  ]
}
